{
    "name": "veyl-frontend",
    "private": true,
    "version": "0.1.5",
    "type": "module",
    "description": "VeylVPN desktop app and web client",
    "author": "Luckyz",
    "license": "GPL-3.0-or-later",
    "scripts": {
        "fonts": "node scripts/fonts.ts",
        "landmask": "node scripts/landmask.ts",
        "dev": "node scripts/fonts.ts && vite",
        "build": "node scripts/fonts.ts && vite build",
        "preview": "vite preview",
        "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
        "test": "vitest run",
        "lint": "biome lint src scripts tests",
        "app": "tauri dev",
        "dist:win": "tauri build"
    },
    "dependencies": {
        "@tauri-apps/api": "^2.12.1",
        "@tauri-apps/plugin-opener": "^2.5.0",
        "vue": "^3.5.43"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@tailwindcss/vite": "^4.3.3",
        "@tauri-apps/cli": "^2.12.1",
        "@types/node": "^24.0.0",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vue/test-utils": "^2.5.1",
        "happy-dom": "^20.14.5",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "vite": "^8.3.2",
        "vitest": "^5.0.3",
        "vue-tsc": "^3.3.11"
    },
    "packageManager": "pnpm@12.5.1"
}
