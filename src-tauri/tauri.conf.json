{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veyl",
  "version": "0.1.0",
  "identifier": "net.veyl.client",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "VeylVPN",
        "width": 1080,
        "height": 720,
        "minWidth": 760,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "center": true,
        "backgroundColor": "#05050a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://stat.ripe.net"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
